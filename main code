
#include <Wire.h>
#include <Servo.h>
#include <U8g2lib.h>
#include <Adafruit_INA219.h>

// OLED: SH1106 128x64, I2C, page-buffer mode
U8G2_SH1106_128X64_NONAME_1_HW_I2C oled(
  U8G2_R0, U8X8_PIN_NONE
);

Adafruit_INA219 ina219;

// LDR pins
const int UL = A0;
const int UR = A1;
const int LL = A2;
const int LR = A3;

// Servo pins
const int VERTICAL_SERVO_PIN = 10;
const int HORIZONTAL_SERVO_PIN = 9;

Servo verticalServo;
Servo horizontalServo;

// Servo positions
int verticalAngle = 90;
int horizontalAngle = 90;

// Mechanical limits: keep these within your existing build
const int VERTICAL_MIN = 70;
const int VERTICAL_MAX = 110;

const int HORIZONTAL_MIN = 40;
const int HORIZONTAL_MAX = 140;

// Tracking settings
const int TOLERANCE = 60;
const int STEP_SIZE = 1;

unsigned long lastTrackTime = 0;
unsigned long lastDisplayTime = 0;

const unsigned long TRACK_INTERVAL = 400;
const unsigned long DISPLAY_INTERVAL = 1000;

// Sensor readings
int ulValue, urValue, llValue, lrValue;
int topAvg, bottomAvg, leftAvg, rightAvg;
int horizontalDiff, verticalDiff;

// INA219 readings
float panelVoltage = 0;
float current_mA = 0;
float power_mW = 0;

int readAverage(int pin) {
  long total = 0;

  for (int i = 0; i < 5; i++) {
    total += analogRead(pin);
    delay(2);
  }

  return total / 5;
}

void readLDRs() {
  ulValue = readAverage(UL);
  urValue = readAverage(UR);
  llValue = readAverage(LL);
  lrValue = readAverage(LR);

  topAvg = (ulValue + urValue) / 2;
  bottomAvg = (llValue + lrValue) / 2;

  leftAvg = (ulValue + llValue) / 2;
  rightAvg = (urValue + lrValue) / 2;

  horizontalDiff = leftAvg - rightAvg;
  verticalDiff = topAvg - bottomAvg;
}

void trackSun() {

  // Horizontal tracking
  if (horizontalDiff > TOLERANCE) {
    horizontalAngle += STEP_SIZE;
  }
  else if (horizontalDiff < -TOLERANCE) {
    horizontalAngle -= STEP_SIZE;
  }

  // Vertical tracking
  if (verticalDiff > TOLERANCE) {
    verticalAngle += STEP_SIZE;
  }
  else if (verticalDiff < -TOLERANCE) {
    verticalAngle -= STEP_SIZE;
  }

  // Apply mechanical limits
  horizontalAngle = constrain(
    horizontalAngle,
    HORIZONTAL_MIN,
    HORIZONTAL_MAX
  );

  verticalAngle = constrain(
    verticalAngle,
    VERTICAL_MIN,
    VERTICAL_MAX
  );

  horizontalServo.write(horizontalAngle);
  verticalServo.write(verticalAngle);
}

void readPower() {

  float busVoltage = ina219.getBusVoltage_V();
  float shuntVoltage = ina219.getShuntVoltage_mV();

  panelVoltage = busVoltage + (shuntVoltage / 1000.0);

  current_mA = ina219.getCurrent_mA();

  // V x mA = mW
  power_mW = panelVoltage * current_mA;
}

void updateOLED() {

  oled.firstPage();

  do {
    oled.setFont(u8g2_font_6x10_tf);

    oled.drawStr(0, 10, "DUAL AXIS SOLAR TRACKER");

    oled.setCursor(0, 23);
    oled.print("Voltage: ");
    oled.print(panelVoltage, 2);
    oled.print(" V");

    oled.setCursor(0, 35);
    oled.print("Current: ");
    oled.print(current_mA, 2);
    oled.print(" mA");

    oled.setCursor(0, 47);
    oled.print("Power: ");
    oled.print(power_mW, 2);
    oled.print(" mW");

    oled.setCursor(0, 59);
    oled.print("H:");
    oled.print(horizontalAngle);
    oled.print(" V:");
    oled.print(verticalAngle);

  } while (oled.nextPage());
}

void printSerial() {

  Serial.print("UL: ");
  Serial.print(ulValue);

  Serial.print(" UR: ");
  Serial.print(urValue);

  Serial.print(" LL: ");
  Serial.print(llValue);

  Serial.print(" LR: ");
  Serial.print(lrValue);

  Serial.print(" | H Diff: ");
  Serial.print(horizontalDiff);

  Serial.print(" | V Diff: ");
  Serial.print(verticalDiff);

  Serial.print(" | H Angle: ");
  Serial.print(horizontalAngle);

  Serial.print(" | V Angle: ");
  Serial.print(verticalAngle);

  Serial.print(" | Voltage: ");
  Serial.print(panelVoltage, 2);

  Serial.print(" V | Current: ");
  Serial.print(current_mA, 2);

  Serial.print(" mA | Power: ");
  Serial.print(power_mW, 2);

  Serial.println(" mW");
}

void setup() {

  Serial.begin(9600);
  Wire.begin();

  verticalServo.attach(VERTICAL_SERVO_PIN);
  horizontalServo.attach(HORIZONTAL_SERVO_PIN);

  verticalServo.write(verticalAngle);
  horizontalServo.write(horizontalAngle);

  oled.begin();

  if (!ina219.begin()) {
    Serial.println("INA219 not detected!");
  }
  else {
    Serial.println("INA219 detected.");
  }

  Serial.println("Solar tracker started.");
}

void loop() {

  unsigned long currentTime = millis();

  if (currentTime - lastTrackTime >= TRACK_INTERVAL) {

    lastTrackTime = currentTime;

    readLDRs();
    trackSun();
    printSerial();
  }

  if (currentTime - lastDisplayTime >= DISPLAY_INTERVAL) {

    lastDisplayTime = currentTime;

    readPower();
    updateOLED();
  }
}
